{
  "name": "porto-vol-2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun scripts/clean-ports.ts && bun --filter \"*\" --parallel dev",
    "clean:ports": "bun scripts/clean-ports.ts",
    "dev:web": "bun --filter web dev",
    "dev:admin": "bun --filter admin dev",
    "dev:api": "bun --filter api dev",
    "build": "bun run sync:content && bun run optimize:images && bun --filter \"*\" build",
    "sync:content": "bun scripts/sync-content.ts",
    "optimize:images": "bun scripts/convert-webp.ts",
    "check": "bun --filter web check && bun --filter admin check"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
